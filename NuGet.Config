<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <!--
      Sources were cleared while this was originally built in a network-restricted
      sandbox. The project now references real packages (Duende IdentityServer,
      ASP.NET Core Identity + EF Core, Swashbuckle for Swagger), so nuget.org is
      restored here to make `dotnet restore` work on any machine.
    -->
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
